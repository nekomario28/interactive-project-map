# PUBLIC PLACEHOLDER FILE ONLY. Never replace these values with real credentials in git.
# Copy this file to the ignored `.dev.vars` for local development and set real values there.

# Optional. Strongly recommended for production to raise GitHub API rate limits.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# Dormant one-click installer. Keep false for normal/public operation.
# Reactivation requires an explicit reviewed decision plus real-credential acceptance.
ENABLE_ONE_CLICK_INSTALLER=false

# Retained one-click implementation secrets. Leave unset unless deliberately testing/reactivating it.
# Register a public GitHub App that requests user authorization during installation.
GITHUB_APP_SLUG=interactive-project-map
GITHUB_APP_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_APP_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Generate at least 32 random bytes, e.g. `openssl rand -hex 32`.
INSTALL_STATE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
